<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>FZScout.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FZScout</RootNamespace>
    <Product>FZScout</Product>
    <!-- The release being worked on: a strictly incrementing integer. The release workflow publishes it, then bumps it. -->
    <Version>8</Version>
  </PropertyGroup>

  <!-- Published as a self-contained x64 app for Velopack to pack. Only when publishing, so the tests can reference this project. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Nothing next to the exe: symbols go inside it, and the XML docs exist only for the analyzers. -->
    <DebugType>embedded</DebugType>
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>

  <!-- WPF drops these from the implicit usings, though nothing here clashes with them. -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FZScout.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="FZScout.ico" LogicalName="FZScout.ico" />
    <EmbeddedResource Include="FZScoutWaiting.ico" LogicalName="FZScoutWaiting.ico" />
    <EmbeddedResource Include="FZScoutNotScouting.ico" LogicalName="FZScoutNotScouting.ico" />
    <EmbeddedResource Include="FZScoutStopped.ico" LogicalName="FZScoutStopped.ico" />
    <EmbeddedResource Include="FZScoutProblem.ico" LogicalName="FZScoutProblem.ico" />
    <EmbeddedResource Include="FZScoutWaitingProblem.ico" LogicalName="FZScoutWaitingProblem.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="EverQuestLogWatcher" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" />
    <PackageReference Include="NotificationTrayIconVisibility" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

</Project>
