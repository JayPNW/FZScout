<local:FixedSizeDialog x:Class="FZScout.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FZScout"
        Title="FZScout Settings">
    <StackPanel Margin="12" Width="440">
        <DockPanel>
            <Label DockPanel.Dock="Left" Content="_API key:" Target="{Binding ElementName=ApiKeyBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="_Verify" IsDefault="True" Command="{Binding VerifyApiKeyCommand}" Padding="12,2" Margin="6,0,0,0" />
            <Grid>
                <PasswordBox x:Name="ApiKeyBox" PasswordChanged="CopyApiKeyToViewModel" VerticalContentAlignment="Center">
                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ApiKeyVerificationStatus}" Value="Verifying">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>
                <!-- Shows which key is saved, without ever putting the whole key on screen. Typing a new key hides it. -->
                <TextBlock Text="{Binding SavedApiKeyAbbreviation}" Foreground="{x:Static SystemColors.GrayTextBrush}" Margin="4,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ApiKeyBeingEdited}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>

        <TextBlock Margin="0,8,0,0">
            <Run Text="Get an API key from" />
            <Hyperlink NavigateUri="https://fangbreaker.zone/account" RequestNavigate="OpenLinkInBrowser">fangbreaker.zone/account</Hyperlink><Run Text="." />
            <Hyperlink NavigateUri="https://jaypnw.github.io/FZScout/create-api-key.html" RequestNavigate="OpenLinkInBrowser">Need help?</Hyperlink>
        </TextBlock>

        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="Firebrick" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ApiKeyVerificationStatus}" Value="NotVerified">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ApiKeyVerificationStatus}" Value="Verifying">
                            <Setter Property="Text" Value="Checking the API key with the site..." />
                            <Setter Property="Foreground" Value="{x:Static SystemColors.GrayTextBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ApiKeyVerificationStatus}" Value="VerifiedAndSaved">
                            <Setter Property="Text" Value="API key verified and saved." />
                            <Setter Property="Foreground" Value="ForestGreen" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ApiKeyVerificationStatus}" Value="RejectedBySite">
                            <Setter Property="Text" Value="The site rejected this API key." />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ApiKeyVerificationStatus}" Value="CouldNotCheckWithSite">
                            <Setter Property="Text" Value="Couldn't check the API key with the site. The log has the details." />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ApiKeyVerificationStatus}" Value="CouldNotSave">
                            <Setter Property="Text" Value="Couldn't save the API key. The log has the details." />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <CheckBox Margin="0,12,0,0" Content="_Launch FZScout when I log in to Windows" IsChecked="{Binding LaunchesAtLogin}" />
        <CheckBox Margin="0,6,0,0" Content="Show _toast notifications" IsChecked="{Binding ShowsToastNotifications}" />

        <Button Margin="0,12,0,0" HorizontalAlignment="Right" Content="Close" IsCancel="True" Padding="12,2" Click="CloseWindow" />
    </StackPanel>
</local:FixedSizeDialog>
